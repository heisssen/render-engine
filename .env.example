# Copy to .env (never committed) or set these in your environment.

# ElevenLabs API key, used by en/voice.py and en/dub.py.
ELEVENLABS_API_KEY=

# Your narrator voice: the ID of your own ElevenLabs voice (a clone or any voice in your library).
# Empty = the public stock voice "Brian". Changing it re-voices every narrator paragraph (takes are cached by voice ID).
NARRATOR_VOICE_ID=

# Optional: where downloaded elevation tiles and the translation sandbox go (default: out/cache).
RE_CACHE=

# Optional: Hugging Face cache for the whisper models (default: the HF default in your user profile).
HF_HOME=

# Optional: python.exe of a separate venv with DepthFlow, for en/parallax.py only.
DEPTHFLOW_PYTHON=
